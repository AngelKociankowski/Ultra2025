# Copia este archivo a .env.local y ajusta lo que necesites.
# Todas las variables son opcionales: sin ninguna, la app corre con los
# valores de abajo.

# Dónde vive la base SQLite. Debe ser un disco que persista entre despliegues.
# Por omisión: ./data/ultra.db
# DATABASE_PATH=/var/lib/ultra/ultra.db

# Puerto de `npm run start`. Por omisión: 3000
# PORT=3000

# Contraseña con la que el seed da de alta las cinco cuentas iniciales.
# Por omisión: UltraGuardias2026 — cámbiala antes de sembrar en producción.
# SEED_PASSWORD=
