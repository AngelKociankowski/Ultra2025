# Copia este archivo a .env.local y ajusta lo que necesites.
# Todas las variables son opcionales: sin ninguna, la app corre con los
# valores de abajo.

# Dónde vive la base SQLite. Debe ser un disco que persista entre despliegues.
# Por omisión: ./data/ultra.db
# DATABASE_PATH=/var/lib/ultra/ultra.db

# Puerto de `npm run start`. Por omisión: 3000
# PORT=3000

# Contraseña con la que el seed da de alta las cinco cuentas iniciales.
# Por omisión: UltraGuardias2026 — cámbiala antes de sembrar en producción.
# SEED_PASSWORD=

# La llave del servicio que escribe las respuestas del asistente. Sin ella, el
# asistente no aparece en la barra y la plataforma funciona exactamente igual:
# la pantalla /asistente enseña la guía del rol en vez de un error.
# Vive solo en el servidor. Nunca viaja al navegador.
# ANTHROPIC_API_KEY=

# Preguntas al asistente por persona y por día. Por omisión: 25
# Al llegar se cierra hasta el día siguiente, con un aviso que lo dice.
# CHAT_TOPE_PREGUNTAS=25

# Gasto estimado del asistente para TODA la empresa en un día, en centavos de
# dólar. Por omisión: 60 — existe para que una persona no se lleve el mes.
# CHAT_TOPE_CENTAVOS=60
